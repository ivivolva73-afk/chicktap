<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ChickTap</title>
    <script src="https://telegram.org/js/telegram-web-app.js"></script>
    <style>
        body { text-align: center; font-family: sans-serif; background: #f7d547; margin: 0; padding: 20px; user-select: none; }
        #score { font-size: 40px; font-weight: bold; color: #333; margin: 20px 0; }
        #chick { font-size: 120px; cursor: pointer; transition: transform 0.1s; display: inline-block; }
        #chick:active { transform: scale(0.85); }
    </style>
</head>
<body>
    <h1>ChickTap 🐥</h1>
    <div id="score">0</div>
    <div id="chick">🐣</div>

    <script>
        let count = 0;
        const scoreEl = document.getElementById('score');
        const chickEl = document.getElementById('chick');

        chickEl.addEventListener('click', () => {
            count++;
            scoreEl.innerText = count;
        });

        window.Telegram.WebApp.ready();
        window.Telegram.WebApp.expand();
    </script>
</body>
</html>
